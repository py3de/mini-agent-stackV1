# ---- LLM provider -------------------------------------------------------
# Which provider the agent uses by default: google | openai | anthropic | ollama
LLM_PROVIDER=google

# Optional: override the default model per provider (model names change often,
# so check each provider's docs for the current ones).
# MODEL_GOOGLE=gemini-3.8-flash
# MODEL_OPENAI=gpt-4.1-mini
# MODEL_ANTHROPIC=claude-haiku-4-5
# MODEL_OLLAMA=llama3.1

# Backup models used automatically if the main model fails (e.g. "503 high demand").
# Default for google: google:gemini-3.5-flash-lite. Format: provider:model, comma-separated.
# LLM_FALLBACKS=google:gemini-3.5-flash-lite,openai:gpt-4.1-mini

# Per-call limits before switching to a backup model (defaults: 1 retry, 60 s timeout).
# LLM_MAX_RETRIES=1
# LLM_TIMEOUT_S=60
# Optional sampling temperature (leave unset for models with fixed sampling, e.g. Gemini 3.x).
# LLM_TEMPERATURE=0

# API keys: only the providers you actually use need a key.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama runs locally and needs no key: https://ollama.com

# ---- Knowledge base (RAG) ---------------------------------------------------
# Embeddings provider for the knowledge base: google | openai | ollama
# (defaults to LLM_PROVIDER; Anthropic has no embeddings API and falls back to google)
# EMBEDDINGS_PROVIDER=google
# EMBEDDINGS_MODEL_GOOGLE=gemini-embedding-2

# ---- HubSpot -------------------------------------------------------------
# mock = in-memory demo CRM (default, no account needed)
# live = real HubSpot API (create a free developer test account + private app)
HUBSPOT_MODE=mock
HUBSPOT_ACCESS_TOKEN=

# ---- LangSmith tracing (optional, free tier is enough) --------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mini-agent-stack

# ---- Webhook API -----------------------------------------------------------
# Shared secret that callers must send in the X-Webhook-Secret header.
WEBHOOK_SECRET=change-me
